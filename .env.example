# Copia este archivo a .env y ajusta los valores.
# Nunca subas .env ni credenciales reales al repositorio.

# --- Rutas (en Docker se sobreescriben a /app/data) ---
RFE_DATA_DIR=./data
# Nombre del Excel dentro de data/input/ que usa docker-compose.yml.
RFE_INPUT_FILE=entrada.xls
# Columna y zonas del Excel a procesar. Vacío = todas las filas.
# Ejemplo: RFE_ZONAS=1101,1111
RFE_ZONE_COLUMN=CVE ZONA
RFE_ZONAS=
# Permisos de carpetas y archivos generados (octal). Por defecto privados.
# En Docker con volumen compartido usa 2770/660 para que el grupo del host
# pueda leer las salidas sin exponerlas a otros usuarios.
RFE_DIR_MODE=700
RFE_FILE_MODE=600
# UID del contenedor y GID del grupo del host (solo docker-compose.yml).
# Ajusta RFE_GID al `id -g` del usuario que debe leer las salidas.
RFE_UID=10001
RFE_GID=1000

# --- SASA / QuickSASA ---
SASA_URL=http://168.255.120.98/quickSASA/BuscarRFE
SASA_ESTADO=gto
SASA_METHOD=POST

# --- SIGA (INEA, módulo Figuras) ---
# Requiere usuario y contraseña. Sin URL o sin credenciales el cliente
# devuelve NO_CONFIGURADO y la regla de continuidad no se puede confirmar.
SIGA_URL=http://siga.inea.gob.mx/Figuras
# Ciclos escolares que se consultan por RFE.
SIGA_CICLOS=2016,2017
# Renueva la sesión tras N peticiones.
SIGA_RELOGIN_CADA=500

# --- SIGED ---
# API pública de consulta del alumnado. Requiere CURP, no RFE.
# El pipeline la usa solo si el Excel trae una columna CURP válida.
SIGED_URL=https://api.siged.sep.gob.mx/CoreServices/servicios
# json (API real) | html (instancia con página de etiquetas/tablas)
SIGED_FORMAT=json
SIGED_METHOD=GET
# Solo se usa cuando SIGED_FORMAT=html
SIGED_ID_PARAM=rfe
# always | on_demand | never
SIGED_MODE=on_demand
# Si el servidor no envía la cadena TLS completa, instala el CA intermedio o
# pon false SOLO dentro de una red confiable.
SIGED_VERIFY_TLS=true

# --- Credenciales (solo si la plataforma las exige) ---
SASA_USER=
SASA_PASSWORD=
SASA_TOKEN=
SIGA_USER=
SIGA_PASSWORD=
SIGA_TOKEN=
SIGED_USER=
SIGED_PASSWORD=
SIGED_TOKEN=
# Opcional: JSON con bloques "sasa", "siga", "siged".
# RFE_CREDENTIALS_FILE=/app/data/credentials.json

# --- Red / resiliencia ---
REQUEST_TIMEOUT=20
MAX_RETRIES=3
BACKOFF_FACTOR=1.5
DELAY_MIN=1.0
DELAY_MAX=2.5
RECORD_DELAY_MIN=0.0
RECORD_DELAY_MAX=0.5

# --- Privacidad ---
PRIVACY_VERSION=1.0
# Si se deja vacío se genera un salt local en data/state/.privacy_salt
PRIVACY_SALT=
CHECKPOINT_HASH_IDENTIFIERS=true
CHECKPOINT_STORE_RAW=false
# Reintenta una vez al final los registros con ERROR transitorio y los vuelve
# a intentar al reanudar la corrida.
RETRY_ERRORS=true
RETENTION_DAYS=90

# --- Excel / logging ---
RFE_LENGTH=13
CURP_LENGTH=18
LOG_LEVEL=INFO
